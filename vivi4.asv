function dY = vivi4(~,Y,P)
%% Parametros del modelo:

rmax1=P(1);
theta1=P(2);
m1=P(3);
K1=P(4);
T_opt1_0=P(5);
epsilon1=P(6);
Tmax1=P(7);
G1=P(8);
d1=P(9);

rmax2=P(10);
theta2=P(11);
m2=P(12);
K2=P(13);
T_opt2_0=P(14);
epsilon2=P(5);
Tmax2=P(16);
G2=P(17);
d2=P(18);

rmax3=P(19);
theta3=P(20);
m3=P(21);
K3=P(22);
T_opt3_0=P(23);
epsilon3=P(24);
Tmax3=P(25);
G3=P(26);
d3=P(27);

%El modelo
%% Lista de Ecuaciones
dY=zeros(9,1);
dY(1) = Y(1)*rmax1*(exp((-(Y(3)-m1*Y(2)-T_opt1_0)^2)/(2*theta1^2)))*(1-Y(1)/K1);
dY(2) = G1*(1-Y(1)/K1)*rmax1 * exp((-(Y(3)-m1*Y(2)-T_opt1_0)^2)/(2*theta1^2))* m1*(Y(3)-m1*Y(2)-T_opt1_0)/theta1^2;
dY(3) = epsilon1;

dY(4) = Y(4)*rmax*(exp((-(Y(6)-m*Y(5)-T_opt_0)^2)/(2*theta^2)))*(1-Y(4)/K);
dY(5) = G*(1-Y(4)/K)*rmax * exp((-(Y(3)-m*Y(5)-T_opt_0)^2)/(2*theta^2))* m*(Y(3)-m*Y(5)-T_opt_0)/theta^2;
dY(6) = epsilon;

 % Aplicar la condición para la variable Y(3) environmental variable
    if Y(3) < Tmax
        dY(3) = epsilon;
    else
        dY(3) = 0;
    end

